rules_version = '2';

// Deny by default. Browsers never write bookings: all booking creation and
// changes go through the backend (Firebase Admin SDK), which bypasses these
// rules. Clients may only read what is explicitly listed below.
//
// The booking form no longer writes to Firestore: it calls POST /api/bookings,
// which creates bookings with the Admin SDK (bypassing these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin status is a custom claim set only by the Admin SDK
    // (backend/scripts/set-admin-claim.js). Email addresses are never used.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Customer bookings contain personal data (name, phone, address). NO client can read
    // or write them, admins included: the admin dashboard uses the backend's paginated,
    // audited API (GET /api/admin/bookings), which reads with the Admin SDK. This also
    // means a browser can never pull the whole collection.
    match /bookings/{bookingId} {
      allow read, write: if false;
    }

    // Public catalog. Storefront-visible entries are readable by anyone; inactive
    // (disabled/draft) entries only by admins. Queries must filter on active == true.
    // Written only by the backend (seed script now, admin API later).
    match /categories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if false;
    }

    match /packages/{packageId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if false;
    }

    // Slot configuration (time, label, capacity, weekdays). Enabled slots are public
    // (the backend serves availability; this only allows reading the configuration).
    // Written only by the backend (seed script now, admin API later).
    match /slots/{slotId} {
      allow read: if resource.data.enabled == true || isAdmin();
      allow write: if false;
    }

    // Blocked dates may carry private reasons ("owner away"): backend only.
    match /blockedDates/{date} {
      allow read, write: if false;
    }

    // Per date+slot occupancy (bookedCount, bookingIds). Written ONLY by the backend, inside
    // the booking/admin transactions. Customers see availability through GET /api/availability.
    match /slotBookings/{key} {
      allow read, write: if false;
    }

    // The admin audit trail: append-only, written by the backend inside each admin
    // transaction and read through GET /api/admin/audit. Never accessible from a browser.
    match /auditLogs/{entryId} {
      allow read, write: if false;
    }

    // Everything else: closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
