# Frontend environment variables (Vite).
# Copy to `.env` for local development:  cp .env.example .env
# On Vercel, set these under Project Settings -> Environment Variables.
#
# IMPORTANT: every VITE_* value is compiled into the public JavaScript bundle
# and is visible to anyone who opens the site. Never put private keys, service
# account JSON, payment secrets or passwords here.
#
# Values are read at BUILD time (see src/firebase-config.js). After changing a
# value on Vercel you must redeploy for it to take effect.

# --- Firebase Web App config -------------------------------------------------
# Firebase console -> Project settings -> General -> Your apps -> Web app.
# These identify your project; they are not secrets, but restrict the API key
# by HTTP referrer in Google Cloud Console -> APIs & Services -> Credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional (Google Analytics). Leave empty to disable.
VITE_FIREBASE_MEASUREMENT_ID=

# --- Backend API ---------------------------------------------------------------
# Base URL of the Express API, no trailing slash.
# Local:      http://localhost:5000
# Production: https://your-api.onrender.com
# REQUIRED for the admin dashboard: it asks this API (GET /api/admin/me) whether the
# signed-in user is an admin. Without it, admin login fails closed.
VITE_API_URL=http://localhost:5000
