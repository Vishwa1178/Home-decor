# Backend environment variables (Express API).
# Copy to `.env` for local development:  cp .env.example .env
# On Render, set these under the service's Environment tab (never commit .env).
#
# Read in src/config/env.js.

# "development" | "production" | "test".
# Defaults to "development" when unset, and in development the error handler
# includes stack traces in responses. ALWAYS set this to "production" in deploys.
NODE_ENV=development

# Port to listen on. Render injects PORT itself, so leave it unset there.
# Defaults to 5000.
PORT=5000

# Comma-separated list of allowed browser origins, no trailing slashes.
#   Local:      http://localhost:5173
#   Production: https://your-site.vercel.app,https://www.your-domain.com
# WARNING: when unset, the server currently reflects ANY request origin
# (with credentials). Always set this in production.
CORS_ORIGIN=http://localhost:5173

# --- Firebase Admin SDK (token verification, admin claims, Firestore) ---------
# Firebase project ID. REQUIRED when NODE_ENV=production (the server refuses to
# start without it). Must match the project the frontend signs in against.
FIREBASE_PROJECT_ID=your-project-id

# Service account credentials. Firebase console -> Project settings -> Service
# accounts -> Generate new private key. Paste the JSON on one line, or base64 it:
#   base64 -w0 serviceAccountKey.json
# Needed for revocation checks, `npm run admin:claim` and (Phase 2) Firestore
# writes. NEVER commit this value or the key file. Alternative: set
# GOOGLE_APPLICATION_CREDENTIALS to the key file path (local development).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Reject ID tokens that have been revoked. Requires the service account above.
# Defaults to true in production, false otherwise.
# FIREBASE_CHECK_REVOKED=true

# Local testing against the Firebase Auth emulator (see docs/PHASE1.md):
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Booking rules -------------------------------------------------------------
# Payment amounts are not configured here: the customer picks HALF (50%, rounded up to
# whole rupees) or FULL and the server calculates the amounts from the catalog price.

# Booking dates are validated against "today" in this IANA timezone.
# BUSINESS_TIMEZONE=Asia/Kolkata

# A slot stops being bookable this many minutes before it starts (0 = once it has started).
# Slot times, capacity and weekdays are NOT configured here: they live in Firestore (`slots`).
# SLOT_CUTOFF_MINUTES=0

# Seconds-scale in-memory cache for GET /api/packages, in milliseconds. Bookings
# never use it (they read the package price inside the Firestore transaction).
# 0 disables it. Default 30000.
# CATALOG_CACHE_TTL_MS=30000

# --- Rate limits (per client IP, per instance) ---------------------------------
# RATE_LIMIT_BOOKINGS_MAX=10          # POST /api/bookings and /validate
# RATE_LIMIT_BOOKINGS_WINDOW_MS=900000
# RATE_LIMIT_CATALOG_MAX=120          # GET /api/packages
# RATE_LIMIT_CATALOG_WINDOW_MS=60000
# RATE_LIMIT_AVAILABILITY_MAX=120     # GET /api/availability
# RATE_LIMIT_AVAILABILITY_WINDOW_MS=60000
# RATE_LIMIT_ADMIN_MAX=240            # /api/admin/*
# RATE_LIMIT_ADMIN_WINDOW_MS=60000

# Local development against the Firestore emulator (never set in production; the
# server refuses to start if it is): FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
