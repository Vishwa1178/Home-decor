{
  "name": "home-decor-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for the Home Decor booking site",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "admin:claim": "node scripts/set-admin-claim.js",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:emulator": "npx --yes firebase-tools@15.31.0 emulators:exec --config ../firebase.json --project demo-home-decor --only auth,firestore \"node --test --test-concurrency=1 tests/emulator/*.test.js\"",
    "catalog:seed": "node scripts/seed-catalog.js",
    "slots:seed": "node scripts/seed-slots.js",
    "bookings:backfill": "node scripts/backfill-bookings.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0"
  }
}
